{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "docs",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "mkdocs", "serve", "--dev-addr", "127.0.0.1:8765"],
      "port": 8765
    },
    {
      "name": "site",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "python", "-m", "http.server", "8766", "--bind", "127.0.0.1", "--directory", "site"],
      "port": 8766
    }
  ]
}
